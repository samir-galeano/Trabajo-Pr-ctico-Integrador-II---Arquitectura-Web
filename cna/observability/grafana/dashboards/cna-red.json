          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "jetstream_stream_total_messages{stream_name=\"BOOKSTACK\"}",
          "legendFormat": "en BOOKSTACK"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Exportaciones: cola Redis y throughput",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "C2: escalar export-worker de 1 a 3 y comparar jobs/min.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",

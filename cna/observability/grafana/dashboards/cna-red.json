        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "jetstream_consumer_num_ack_pending",
          "legendFormat": "{{stream_name}} / {{consumer_name}} sin ack"
        }

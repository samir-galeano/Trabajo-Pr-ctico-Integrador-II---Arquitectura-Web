    {
      "type": "logs",
      "title": "Logs por servicio y request_id",
      "id": 18,
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Escribir un request_id arriba para ver la misma operación en gateway, event-bridge, search-svc y audit-svc.",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",

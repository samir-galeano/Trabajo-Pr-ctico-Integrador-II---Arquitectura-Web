BOOKSTACK_BASE_URL=https://bookstack.local
BOOKSTACK_TOKEN_ID=CAMBIAR_BOOKSTACK_TOKEN_ID
BOOKSTACK_TOKEN_SECRET=CAMBIAR_BOOKSTACK_TOKEN_SECRET
BOOKSTACK_VERIFY_TLS=false
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=CAMBIAR_MINIO_PASSWORD
MINIO_BUCKET=bookstack-exports
# Dirección de MinIO con la que se firman las URL de descarga (debe ser
# accesible desde el cliente que descarga el archivo).
MINIO_PUBLIC_ENDPOINT=http://192.168.0.6:9000
# Vigencia de la URL prefirmada (segundos)
EXPORT_URL_EXPIRES=900

# Cola de jobs (compartida por la API y los workers)
REDIS_URL=redis://export-redis:6379/0
# Si un worker muere, su job vuelve a la cola cuando vence el lease
EXPORT_LEASE_TTL=15
EXPORT_MAX_ATTEMPTS=3
# Demora artificial por job, solo para los experimentos X3 y C2 (0 = sin demora)
EXPORT_SIMULATED_DELAY=0

# Eventos export.requested / export.completed / export.failed (vacío = desactivados)
NATS_URL=nats://nats:4222

# Token Bearer de la API pública (BearerAuth). Vacío = sin autenticación.
# Admite varios separados por comas (para rotarlo sin corte).
API_AUTH_TOKEN=CAMBIAR_API_TOKEN

DATABASE_HOST=search-index-db
DATABASE_PORT=5432
DATABASE_NAME=searchdb
DATABASE_USER=searchsvc
DATABASE_PASSWORD=CAMBIAR_PG_PASSWORD
BOOKSTACK_BASE_URL=https://bookstack.local
BOOKSTACK_TOKEN_ID=CAMBIAR_BOOKSTACK_TOKEN_ID
BOOKSTACK_TOKEN_SECRET=CAMBIAR_BOOKSTACK_TOKEN_SECRET
BOOKSTACK_VERIFY_TLS=false
NATS_URL=nats://nats:4222

# Resiliencia hacia la API de BookStack (X5)
BOOKSTACK_CONNECT_TIMEOUT=3
BOOKSTACK_READ_TIMEOUT=5
BOOKSTACK_MAX_RETRIES=3
BOOKSTACK_BACKOFF_BASE=0.5
BOOKSTACK_BACKOFF_MAX=8
# Fallos seguidos que abren el circuito y segundos que permanece abierto
BOOKSTACK_CB_FAILURES=5
BOOKSTACK_CB_RESET=30
# Llamadas simultáneas máximas a BookStack (bulkhead)
BOOKSTACK_MAX_CONCURRENCY=4

# Token Bearer de la API pública (BearerAuth). Vacío = sin autenticación.
# Admite varios separados por comas (para rotarlo sin corte).
API_AUTH_TOKEN=CAMBIAR_API_TOKEN

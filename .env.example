# Variables de interpolación para compose.yaml (copiar a .env)
# IP de la VM donde corre BookStack (VM-1). Se usa para resolver bookstack.local
BOOKSTACK_HOST_IP=192.168.0.17
# IP de VM-2 en la que se publican los puertos (servicios, MinIO y observabilidad).
# El firewall DOCKER-USER (cna/deploy/host-configs/vm2) decide quién puede entrar.
# Para levantar todo en otra máquina (desarrollo): VM2_IP=127.0.0.1
VM2_IP=192.168.0.6
